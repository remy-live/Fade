@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix hmi:    <http://moddevices.com/ns/hmi#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .

<http://remy-live.github.io/lv2/fade>
    a lv2:Plugin , lv2:UtilityPlugin ;

    doap:name "Fade" ;
    doap:license <http://opensource.org/licenses/isc> ;
    doap:maintainer [ foaf:name "Remy" ] ;

    mod:brand "REMY" ;
    mod:label "FADE" ;

    rdfs:comment "Crossfades between two audio inputs. Switch off: input 1. Switch on: input 2. The way out and the way back have their own times, and each input has its own gain. Made for switching a delay or reverb chain in and out without chopping the tail." ;

    lv2:minorVersion 1 ;
    lv2:microVersion 0 ;

    lv2:optionalFeature lv2:hardRTCapable , hmi:WidgetControl ;
    lv2:extensionData hmi:PluginNotification ;

    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in_1" ;
        lv2:name "IN 1" ;
        rdfs:comment "Input 1, usually the dry signal. Heard when the toggle is off."
    ] , [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "in_2" ;
        lv2:name "IN 2" ;
        rdfs:comment "Input 2, usually the effect chain output. Heard when the toggle is on."
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "out" ;
        lv2:name "OUT"
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "toggle" ;
        lv2:name "TOGGLE" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        rdfs:comment "Off: input 1 is heard. On: input 2 is heard. Meant for a footswitch."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "fade_1_2" ;
        lv2:name "FADE 1>2" ;
        lv2:default 1000.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10000.0 ;
        units:unit units:ms ;
        rdfs:comment "Fade time when going from input 1 to input 2. At zero the switch is instant."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "fade_2_1" ;
        lv2:name "FADE 2>1" ;
        lv2:default 1000.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10000.0 ;
        units:unit units:ms ;
        rdfs:comment "Fade time when coming back from input 2 to input 1. At zero the switch is instant."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "progress" ;
        lv2:name "PROGRESS" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "Display port: address it to an encoder to get the fade bar on screen. The plugin writes to it; turning it does nothing."
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 7 ;
        lv2:symbol "position" ;
        lv2:name "POSITION" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Fade position, 0 to 1. Read by the web UI."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "gain_1" ;
        lv2:name "GAIN 1" ;
        lv2:default 0.0 ;
        lv2:minimum -60.0 ;
        lv2:maximum 12.0 ;
        units:unit units:db ;
        rdfs:comment "Gain applied to input 1, before the crossfade. At -60 dB the input is muted."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "gain_2" ;
        lv2:name "GAIN 2" ;
        lv2:default 0.0 ;
        lv2:minimum -60.0 ;
        lv2:maximum 12.0 ;
        units:unit units:db ;
        rdfs:comment "Gain applied to input 2, before the crossfade. At -60 dB the input is muted."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "trigger" ;
        lv2:name "TRIGGER" ;
        lv2:portProperty lv2:toggled , pprops:trigger ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        rdfs:comment "Each pulse starts the fade the other way. Meant for MIDI: a port can only take one addressing, so this control doubles the toggle rather than replacing it."
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 11 ;
        lv2:symbol "state" ;
        lv2:name "STATE" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        rdfs:comment "Input currently targeted: 0 for input 1, 1 for input 2. An output, because a plugin must not write back into an input port."
    ] .
