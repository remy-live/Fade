@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://remy-live.github.io/lv2/fade>
    a lv2:Plugin ;
    lv2:binary <fade.so> ;
    rdfs:seeAlso <fade.ttl> ,
                 <modgui.ttl> .

<http://remy-live.github.io/lv2/fade#stereo>
    a lv2:Plugin ;
    lv2:binary <fade.so> ;
    rdfs:seeAlso <fade_stereo.ttl> ,
                 <modgui.ttl> .
