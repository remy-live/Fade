@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix pset:  <http://lv2plug.in/ns/ext/presets#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<http://remy-live.github.io/lv2/voice#preset_speech>
    a pset:Preset ;
    lv2:appliesTo <http://remy-live.github.io/lv2/voice> ;
    rdfs:label "Speech" ;
    lv2:port [
        lv2:symbol "in_gain" ;
        pset:value 0.0
    ] , [
        lv2:symbol "low_cut" ;
        pset:value 120.0
    ] , [
        lv2:symbol "gate_on" ;
        pset:value 1.0
    ] , [
        lv2:symbol "gate" ;
        pset:value -45.0
    ] , [
        lv2:symbol "comp_on" ;
        pset:value 1.0
    ] , [
        lv2:symbol "comp" ;
        pset:value 35.0
    ] , [
        lv2:symbol "de_ess_on" ;
        pset:value 1.0
    ] , [
        lv2:symbol "de_ess" ;
        pset:value 40.0
    ] , [
        lv2:symbol "body" ;
        pset:value 0.0
    ] , [
        lv2:symbol "presence" ;
        pset:value 4.0
    ] , [
        lv2:symbol "air" ;
        pset:value 2.0
    ] , [
        lv2:symbol "drive_on" ;
        pset:value 0.0
    ] , [
        lv2:symbol "drive" ;
        pset:value 15.0
    ] , [
        lv2:symbol "doubler_on" ;
        pset:value 0.0
    ] , [
        lv2:symbol "doubler" ;
        pset:value 20.0
    ] , [
        lv2:symbol "mod_on" ;
        pset:value 0.0
    ] , [
        lv2:symbol "modulation" ;
        pset:value 25.0
    ] , [
        lv2:symbol "mod_speed" ;
        pset:value 0.6
    ] , [
        lv2:symbol "delay_on" ;
        pset:value 0.0
    ] , [
        lv2:symbol "delay_time" ;
        pset:value 300.0
    ] , [
        lv2:symbol "delay_repeats" ;
        pset:value 20.0
    ] , [
        lv2:symbol "delay_mix" ;
        pset:value 12.0
    ] , [
        lv2:symbol "reverb_on" ;
        pset:value 0.0
    ] , [
        lv2:symbol "reverb" ;
        pset:value 25.0
