@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix hmi:    <http://moddevices.com/ns/hmi#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .

<http://remy-live.github.io/lv2/voice>
    a lv2:Plugin , lv2:DynamicsPlugin ;

    doap:name "Voice" ;
    doap:license <http://opensource.org/licenses/isc> ;
    doap:maintainer [ foaf:name "Remy" ] ;

    mod:brand "REMY" ;
    mod:label "VOICE" ;

    rdfs:comment "A vocal channel strip and effects rack, with no pitch detection anywhere in it: gate, compressor, de-esser, low cut, three tone bands, drive, three-voice doubler, chorus, tap delay and reverb. Every effect has its own switch for a footswitch, and one master switch feeds them all or stops feeding them. Switching off stops the send, not the return, so the delay and the reverb ring out instead of being chopped." ;

    lv2:minorVersion 2 ;
    lv2:microVersion 0 ;

    lv2:optionalFeature lv2:hardRTCapable , hmi:WidgetControl ;
    lv2:extensionData hmi:PluginNotification ;

    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "IN" ;
        rdfs:comment "The microphone, or whatever else is being sung through."
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "OUT"
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "in_gain" ;
        lv2:name "IN GAIN" ;
        lv2:default 0.0 ;
        lv2:minimum -20.0 ;
        lv2:maximum 40.0 ;
        units:unit units:db ;
        rdfs:comment "Gain applied to the input, before everything else. This is a rig setting, not a sound: no preset touches it, so what you set here survives changing preset."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "low_cut" ;
        lv2:name "LOW CUT" ;
        lv2:default 90.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 400.0 ;
        units:unit units:hz ;
        rdfs:comment "High-pass filter on the way in, 6 dB per octave. Takes out stage rumble, handling noise and plosives before they reach the gate. At 0 Hz it is off."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "gate_on" ;
        lv2:name "GATE ON" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Switches the gate in and out. Made for a footswitch."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "gate" ;
        lv2:name "GATE" ;
        lv2:default -80.0 ;
        lv2:minimum -80.0 ;
        lv2:maximum -20.0 ;
        units:unit units:db ;
        rdfs:comment "Gate threshold. Below it the channel closes over about 120 ms, with 6 dB of hysteresis and an 80 ms hold so a held note does not chatter. At -80 dB the gate does nothing whatever its switch says."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "comp_on" ;
        lv2:name "COMP ON" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Switches the compressor in and out. Made for a footswitch."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "comp" ;
        lv2:name "COMP" ;
        lv2:default 30.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "Compression amount. One control: it lowers the threshold and raises the ratio together, from off to -40 dB at 6:1. What it gives back is what it takes off a voice at -12 dBFS, so turning it up changes the sound and not how loud you are. The GR output says how hard it is working."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "de_ess_on" ;
        lv2:name "DE-ESS ON" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Switches the de-esser in and out. Made for a footswitch."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "de_ess" ;
        lv2:name "DE-ESS" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "Tames sibilance by compressing the band above 5.5 kHz alone, so an S loses its edge without the whole word going dull."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "body" ;
        lv2:name "BODY" ;
        lv2:default 0.0 ;
        lv2:minimum -12.0 ;
        lv2:maximum 12.0 ;
        units:unit units:db ;
        rdfs:comment "Low band, below about 240 Hz. Up for weight, down when the microphone is close and the proximity effect has already added it."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 11 ;
        lv2:symbol "presence" ;
        lv2:name "PRESENCE" ;
        lv2:default 0.0 ;
        lv2:minimum -12.0 ;
        lv2:maximum 12.0 ;
        units:unit units:db ;
        rdfs:comment "Middle band, roughly 1 to 4.5 kHz. This is where a voice cuts through a band, and where it gets honky if pushed too far."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 12 ;
        lv2:symbol "air" ;
        lv2:name "AIR" ;
        lv2:default 0.0 ;
        lv2:minimum -12.0 ;
        lv2:maximum 12.0 ;
        units:unit units:db ;
        rdfs:comment "Top band, above about 6 kHz. Breath and detail. Use the de-esser if adding air also brings the sibilance up."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 13 ;
        lv2:symbol "drive_on" ;
        lv2:name "DRIVE ON" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Switches the saturation in and out. Made for a footswitch."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 14 ;
        lv2:symbol "drive" ;
        lv2:name "DRIVE" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "Soft saturation, level-matched at -12 dBFS like the compressor: it adds harmonics and holds down what the compressor left, without making you louder."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 15 ;
        lv2:symbol "doubler_on" ;
        lv2:name "DOUBLE ON" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Switches the doubler in and out. Made for a footswitch."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 16 ;
        lv2:symbol "doubler" ;
        lv2:name "DOUBLE" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "Three copies of the voice, twenty to forty milliseconds late, each drifting a few cents on its own slow LFO and sitting slightly darker than the lead. In the stereo build one goes left, one right and one up the middle."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 17 ;
        lv2:symbol "mod_on" ;
        lv2:name "MOD ON" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Switches the chorus in and out. Made for a footswitch."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 18 ;
        lv2:symbol "modulation" ;
        lv2:name "MOD" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "Chorus. Sets the depth and the amount together. In the stereo build the two sides move a quarter cycle apart, which is where the width comes from."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 19 ;
        lv2:symbol "mod_speed" ;
        lv2:name "MOD SPEED" ;
        lv2:portProperty pprops:logarithmic ;
        lv2:default 0.6 ;
        lv2:minimum 0.05 ;
        lv2:maximum 8.0 ;
        units:unit units:hz ;
        rdfs:comment "Speed of the chorus. Slow is a drift, fast is a vibrato."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 20 ;
        lv2:symbol "delay_on" ;
        lv2:name "DELAY ON" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Switches the delay in and out. It cuts what goes IN, so switching off lets the repeats ring out instead of chopping them. Made for a footswitch."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 21 ;
        lv2:symbol "delay_time" ;
        lv2:name "DELAY" ;
        lv2:portProperty pprops:logarithmic ;
        lv2:default 400.0 ;
        lv2:minimum 20.0 ;
        lv2:maximum 2000.0 ;
        units:unit units:ms ;
        rdfs:comment "Delay time. Two presses of TAP override it; moving this control takes it back. TIME publishes the value actually in force."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 22 ;
        lv2:symbol "delay_repeats" ;
        lv2:name "REPEATS" ;
        lv2:default 30.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 95.0 ;
        units:unit units:pc ;
        rdfs:comment "Delay feedback. The repeats lose their top and their bottom each time round, so a long tail sits behind the voice instead of fighting it."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 23 ;
        lv2:symbol "delay_mix" ;
        lv2:name "DELAY MIX" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "How much delay is heard. The delay also feeds the reverb, so repeats are in the room rather than in front of it."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 24 ;
        lv2:symbol "reverb_on" ;
        lv2:name "REVERB ON" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Switches the reverb in and out. Like the delay it cuts the send, so the tail rings out. Made for a footswitch."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 25 ;
        lv2:symbol "reverb" ;
        lv2:name "REVERB" ;
        lv2:default 40.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "Tail length. Moves the size of the room and its damping together, from a small dry box to a long hall."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 26 ;
        lv2:symbol "reverb_mix" ;
        lv2:name "REVERB MIX" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "How much reverb is heard. At 100 the tail sits at the same level as the voice."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 27 ;
        lv2:symbol "fx" ;
        lv2:name "FX" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "The master switch for all four effects at once. Off: their send is cut over 40 ms and the tails ring out instead of being chopped. Each effect also has its own switch; this one is on top of them."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 28 ;
        lv2:symbol "fx_trigger" ;
        lv2:name "FX TRIGGER" ;
        lv2:portProperty lv2:toggled , pprops:trigger ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Each pulse flips the FX state. Meant for MIDI: a port can only take one addressing, so this doubles the toggle rather than replacing it."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 29 ;
        lv2:symbol "tap" ;
        lv2:name "TAP" ;
        lv2:portProperty lv2:toggled , pprops:trigger ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Tap tempo for the delay. Two presses set the time, from 20 to 2000 ms. Longer than that is treated as a fresh start, not a tempo."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 30 ;
        lv2:symbol "output" ;
        lv2:name "OUTPUT" ;
        lv2:default 0.0 ;
        lv2:minimum -60.0 ;
        lv2:maximum 12.0 ;
        units:unit units:db ;
        rdfs:comment "Output level, after everything. At -60 dB the plugin is silent."
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 31 ;
        lv2:symbol "gr" ;
        lv2:name "GR" ;
        lv2:default 0.0 ;
        lv2:minimum -24.0 ;
        lv2:maximum 0.0 ;
        units:unit units:db ;
        rdfs:comment "Output. Compressor gain reduction in dB, at its worst over the last block. 0 means the compressor is doing nothing."
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 32 ;
        lv2:symbol "level" ;
        lv2:name "LEVEL" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Output. Peak level leaving the plugin, 0 to 1, with a 300 ms fall so a peak stays visible."
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 33 ;
        lv2:symbol "gate_open" ;
        lv2:name "GATE OPEN" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Output. 1 while the gate is open."
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 34 ;
        lv2:symbol "fx_state" ;
        lv2:name "FX STATE" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Output. The FX state actually in force. It exists because the trigger and the toggle drive one state, and a plugin must not write back into either."
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 35 ;
        lv2:symbol "time_out" ;
        lv2:name "TIME" ;
        lv2:default 400.0 ;
        lv2:minimum 20.0 ;
        lv2:maximum 2000.0 ;
        units:unit units:ms ;
        rdfs:comment "Output. The delay time in force, in milliseconds, whether it came from the knob or from the tap."
    ] .
