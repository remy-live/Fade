@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix hmi:    <http://moddevices.com/ns/hmi#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix state:  <http://lv2plug.in/ns/ext/state#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .
@prefix urid:   <http://lv2plug.in/ns/ext/urid#> .

<http://remy-live.github.io/lv2/voice#stereo>
    a lv2:Plugin , lv2:DynamicsPlugin ;

    doap:name "Voice Stereo" ;
    doap:license <http://opensource.org/licenses/isc> ;
    doap:maintainer [ foaf:name "Remy" ] ;

    mod:brand "REMY" ;
    mod:label "VOICE ST" ;

    rdfs:comment "A vocal channel strip and effects rack, with no pitch detection anywhere in it: gate, compressor, de-esser, low cut, three tone bands, drive, three-voice doubler, chorus, tap delay and reverb. Every effect has its own switch for a footswitch, and one master switch feeds them all or stops feeding them. Switching off stops the send, not the return, so the delay and the reverb ring out instead of being chopped." ;

    lv2:minorVersion 5 ;
    lv2:microVersion 0 ;

    lv2:optionalFeature lv2:hardRTCapable , hmi:WidgetControl , urid:map ;
    lv2:extensionData hmi:PluginNotification , state:interface ;

    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in_l" ;
        lv2:name "IN L" ;
        rdfs:comment "Left input."
    ] , [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "in_r" ;
        lv2:name "IN R" ;
        rdfs:comment "Right input."
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "out_l" ;
        lv2:name "OUT L"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "out_r" ;
        lv2:name "OUT R"
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "program" ;
        lv2:name "PROGRAM" ;
        lv2:portProperty lv2:integer , lv2:enumeration , pprops:hasStrictBounds ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 20.0 ;
        lv2:scalePoint
            [ rdfs:label "Manual" ; rdf:value 0.0 ] ,
            [ rdfs:label "Speech" ; rdf:value 1.0 ] ,
            [ rdfs:label "Stage Dry" ; rdf:value 2.0 ] ,
            [ rdfs:label "Ballad" ; rdf:value 3.0 ] ,
            [ rdfs:label "Rock" ; rdf:value 4.0 ] ,
            [ rdfs:label "Wide" ; rdf:value 5.0 ] ,
            [ rdfs:label "Cathedral" ; rdf:value 6.0 ] ,
            [ rdfs:label "Choir" ; rdf:value 7.0 ] ,
            [ rdfs:label "Slapback" ; rdf:value 8.0 ] ,
            [ rdfs:label "Ambient" ; rdf:value 9.0 ] ,
            [ rdfs:label "Radio" ; rdf:value 10.0 ] ,
            [ rdfs:label "Baritone" ; rdf:value 11.0 ] ,
            [ rdfs:label "Tenor" ; rdf:value 12.0 ] ,
            [ rdfs:label "Helium" ; rdf:value 13.0 ] ,
            [ rdfs:label "Octave" ; rdf:value 14.0 ] ,
            [ rdfs:label "User 1" ; rdf:value 15.0 ] ,
            [ rdfs:label "User 2" ; rdf:value 16.0 ] ,
            [ rdfs:label "User 3" ; rdf:value 17.0 ] ,
            [ rdfs:label "User 4" ; rdf:value 18.0 ] ,
            [ rdfs:label "User 5" ; rdf:value 19.0 ] ,
            [ rdfs:label "User 6" ; rdf:value 20.0 ] ;
        rdfs:comment "Picks a sound from the list: MANUAL, the built-in programs, then four slots of your own. MANUAL means the controls below are yours; anything else overrides them for as long as it is selected, and IN GAIN, OUTPUT and every switch stay yours either way. Address it to an encoder to walk the list from the device."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "user_slot" ;
        lv2:name "USER SLOT" ;
        lv2:portProperty lv2:integer , lv2:enumeration , pprops:hasStrictBounds ;
        lv2:default 1.0 ;
        lv2:minimum 1.0 ;
        lv2:maximum 6.0 ;
        lv2:scalePoint
            [ rdfs:label "User 1" ; rdf:value 1.0 ] ,
            [ rdfs:label "User 2" ; rdf:value 2.0 ] ,
            [ rdfs:label "User 3" ; rdf:value 3.0 ] ,
            [ rdfs:label "User 4" ; rdf:value 4.0 ] ,
            [ rdfs:label "User 5" ; rdf:value 5.0 ] ,
            [ rdfs:label "User 6" ; rdf:value 6.0 ] ;
        rdfs:comment "Which of the six USER slots SAVE writes to. It is a separate list from PROGRAM on purpose: it lets you pick a built-in sound, change what you want, and store the result somewhere else without losing the original."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "save" ;
        lv2:name "SAVE" ;
        lv2:portProperty lv2:toggled , pprops:trigger ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Stores WHAT YOU ARE HEARING into the slot USER SLOT points at - the program you picked, plus every change you made to it. Turning any control while a program is selected hands that control back to you, so a built-in sound is a starting point rather than a cage. The slots are saved with the pedalboard."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "in_gain" ;
        lv2:name "IN GAIN" ;
        lv2:default 0.0 ;
        lv2:minimum -20.0 ;
        lv2:maximum 40.0 ;
        units:unit units:db ;
        rdfs:comment "Gain applied to the input, before everything else. This is a rig setting, not a sound: no preset and no program touches it, so what you set here survives everything."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "low_cut" ;
        lv2:name "LOW CUT" ;
        lv2:default 90.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 400.0 ;
        units:unit units:hz ;
        rdfs:comment "High-pass filter on the way in, 6 dB per octave. Takes out stage rumble, handling noise and plosives before they reach the gate. At 0 Hz it is off."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "gate_on" ;
        lv2:name "GATE ON" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Switches the gate in and out. Made for a footswitch."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "gate" ;
        lv2:name "GATE" ;
        lv2:default -80.0 ;
        lv2:minimum -80.0 ;
        lv2:maximum -20.0 ;
        units:unit units:db ;
        rdfs:comment "Gate threshold. Below it the channel closes over about 120 ms, with 6 dB of hysteresis and an 80 ms hold so a held note does not chatter. At -80 dB the gate does nothing whatever its switch says."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 11 ;
        lv2:symbol "comp_on" ;
        lv2:name "COMP ON" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Switches the compressor in and out. Made for a footswitch."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 12 ;
        lv2:symbol "comp" ;
        lv2:name "COMP" ;
        lv2:default 30.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "Compression amount. One control: it lowers the threshold and raises the ratio together, from off to -40 dB at 6:1. What it gives back is most of what it takes off a voice at -12 dBFS, so turning it up changes the sound rather than how loud you are. The GR output says how hard it is working."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 13 ;
        lv2:symbol "de_ess_on" ;
        lv2:name "DE-ESS ON" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Switches the de-esser in and out. Made for a footswitch."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 14 ;
        lv2:symbol "de_ess" ;
        lv2:name "DE-ESS" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "Tames sibilance by compressing the band above 5.5 kHz alone, so an S loses its edge without the whole word going dull."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 15 ;
        lv2:symbol "eq_on" ;
        lv2:name "EQ ON" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Switches the three tone bands in and out together. Made for a footswitch."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 16 ;
        lv2:symbol "body" ;
        lv2:name "BODY" ;
        lv2:default 0.0 ;
        lv2:minimum -12.0 ;
        lv2:maximum 12.0 ;
        units:unit units:db ;
        rdfs:comment "Low band, a shelf below about 240 Hz. Up for weight, down when the microphone is close and the proximity effect has already added it."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 17 ;
        lv2:symbol "mid_freq" ;
        lv2:name "MID FREQ" ;
        lv2:portProperty pprops:logarithmic ;
        lv2:default 2200.0 ;
        lv2:minimum 300.0 ;
        lv2:maximum 5000.0 ;
        units:unit units:hz ;
        rdfs:comment "Where the middle band sits. Low for the chest of a voice, high for the edge that cuts through a band."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 18 ;
        lv2:symbol "presence" ;
        lv2:name "PRESENCE" ;
        lv2:default 0.0 ;
        lv2:minimum -12.0 ;
        lv2:maximum 12.0 ;
        units:unit units:db ;
        rdfs:comment "The middle band, a wide bell around MID FREQ. This is where a voice cuts through, and where it gets honky if pushed too far."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 19 ;
        lv2:symbol "air" ;
        lv2:name "AIR" ;
        lv2:default 0.0 ;
        lv2:minimum -12.0 ;
        lv2:maximum 12.0 ;
        units:unit units:db ;
        rdfs:comment "Top band, a shelf above about 6 kHz. Breath and detail. Use the de-esser if adding air also brings the sibilance up."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 20 ;
        lv2:symbol "drive_on" ;
        lv2:name "DRIVE ON" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Switches the saturation in and out. Made for a footswitch."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 21 ;
        lv2:symbol "drive" ;
        lv2:name "DRIVE" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "Soft saturation, level-matched at -12 dBFS like the compressor: it adds harmonics and holds down what the compressor left, without making you louder."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 22 ;
        lv2:symbol "pitch_on" ;
        lv2:name "PITCH ON" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Switches the pitch shifter in and out. Made for a footswitch."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 23 ;
        lv2:symbol "pitch" ;
        lv2:name "PITCH" ;
        lv2:portProperty lv2:integer , pprops:hasStrictBounds ;
        lv2:default 0.0 ;
        lv2:minimum -12.0 ;
        lv2:maximum 12.0 ;
        rdfs:comment "Shifts the whole voice, in semitones, WITHOUT following its pitch: the signal is read out of a delay line at a different rate, so there is nothing to detect and nothing to mistrack. It moves the formants with the note, which is why down sounds like a bigger singer and up sounds like helium rather than like a harmony. At 0 it is out of the way entirely."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 24 ;
        lv2:symbol "pitch_mix" ;
        lv2:name "PITCH MIX" ;
        lv2:default 100.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "How much of the shifted voice replaces the original. At 100 you hear only the new voice; lower down the two sing together, which at an octave is an octaver and at three or four semitones is a fixed harmony."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 25 ;
        lv2:symbol "doubler_on" ;
        lv2:name "DOUBLE ON" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Switches the doubler in and out. Made for a footswitch."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 26 ;
        lv2:symbol "doubler" ;
        lv2:name "DOUBLE" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "How much of the doubled voices is heard. They arrive twenty to forty-six milliseconds late, each drifting a few cents on its own slow LFO and sitting slightly darker than the lead."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 27 ;
        lv2:symbol "spread" ;
        lv2:name "SPREAD" ;
        lv2:default 50.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "How far apart the doubled voices are: their detune, their drift and how much their entries differ. Low is one singer twice, high is a group of them who have never met."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 28 ;
        lv2:symbol "voices" ;
        lv2:name "VOICES" ;
        lv2:portProperty lv2:integer , lv2:enumeration , pprops:hasStrictBounds ;
        lv2:default 3.0 ;
        lv2:minimum 2.0 ;
        lv2:maximum 4.0 ;
        lv2:scalePoint
            [ rdfs:label "2 voices" ; rdf:value 2.0 ] ,
            [ rdfs:label "3 voices" ; rdf:value 3.0 ] ,
            [ rdfs:label "4 voices" ; rdf:value 4.0 ] ;
        rdfs:comment "How many doubled voices: two for a straight double, three for a thicker one, four for a small choir. The level is held steady as the count changes, so this picks a texture and not a volume. In the stereo build they alternate left and right, with the odd one up the middle."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 29 ;
        lv2:symbol "mod_on" ;
        lv2:name "MOD ON" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Switches the chorus in and out. Made for a footswitch."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 30 ;
        lv2:symbol "modulation" ;
        lv2:name "MOD" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "Chorus. Sets the depth and the amount together. In the stereo build the two sides move a quarter cycle apart, which is where the width comes from."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 31 ;
        lv2:symbol "mod_speed" ;
        lv2:name "MOD SPEED" ;
        lv2:portProperty pprops:logarithmic ;
        lv2:default 0.6 ;
        lv2:minimum 0.05 ;
        lv2:maximum 8.0 ;
        units:unit units:hz ;
        rdfs:comment "Speed of the chorus. Slow is a drift, fast is a vibrato."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 32 ;
        lv2:symbol "feedback_on" ;
        lv2:name "FEEDBACK ON" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Switches the anti-Larsen block in and out. Made for a footswitch."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 33 ;
        lv2:symbol "feedback" ;
        lv2:name "FEEDBACK" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "Hunts acoustic feedback and notches it out. A bank of filters watches for a band that rises and then just sits there - which is what howling does and singing does not - and drops a narrow notch on it. At 0 it is off; turn it up for a loud stage or a distorted guitar in front of its own monitor. NOTCHES says how many are in place."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 34 ;
        lv2:symbol "delay_on" ;
        lv2:name "DELAY ON" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Switches the delay in and out. It cuts what goes IN, so switching off lets the repeats ring out instead of chopping them. Made for a footswitch."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 35 ;
        lv2:symbol "delay_time" ;
        lv2:name "DELAY" ;
        lv2:portProperty pprops:logarithmic ;
        lv2:default 400.0 ;
        lv2:minimum 20.0 ;
        lv2:maximum 2000.0 ;
        units:unit units:ms ;
        rdfs:comment "Delay time. Two presses of TAP override it; moving this control takes it back. TIME publishes the value actually in force."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 36 ;
        lv2:symbol "delay_repeats" ;
        lv2:name "REPEATS" ;
        lv2:default 30.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 95.0 ;
        units:unit units:pc ;
        rdfs:comment "Delay feedback. The repeats lose their top and their bottom each time round, so a long tail sits behind the voice instead of fighting it."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 37 ;
        lv2:symbol "delay_mix" ;
        lv2:name "DELAY MIX" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "How much delay is heard. The delay also feeds the reverb, so repeats are in the room rather than in front of it."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 38 ;
        lv2:symbol "reverb_on" ;
        lv2:name "REVERB ON" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Switches the reverb in and out. Like the delay it cuts the send, so the tail rings out. Made for a footswitch."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 39 ;
        lv2:symbol "reverb" ;
        lv2:name "REVERB" ;
        lv2:default 40.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "Tail length. Moves the size of the room and its damping together, from a small dry box to a long hall."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 40 ;
        lv2:symbol "reverb_mix" ;
        lv2:name "REVERB MIX" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "How much reverb is heard. At 100 the tail sits at the same level as the voice."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 41 ;
        lv2:symbol "fx" ;
        lv2:name "FX" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "The master switch for all four effects at once. Off: their send is cut over 40 ms and the tails ring out instead of being chopped. Each effect also has its own switch; this one is on top of them."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 42 ;
        lv2:symbol "fx_2" ;
        lv2:name "FX 2" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "A second switch on the same FX state, for a second footswitch or a MIDI controller: a port can only take one addressing, so this doubles FX rather than replacing it. Either one flips the state; FX STATE publishes which way it actually is."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 43 ;
        lv2:symbol "tap" ;
        lv2:name "TAP" ;
        lv2:portProperty lv2:toggled , pprops:trigger ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Tap tempo for the delay. Two presses set the time, from 20 to 2000 ms. Longer than that is treated as a fresh start, not a tempo."
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 44 ;
        lv2:symbol "output" ;
        lv2:name "OUTPUT" ;
        lv2:default 0.0 ;
        lv2:minimum -60.0 ;
        lv2:maximum 12.0 ;
        units:unit units:db ;
        rdfs:comment "Output level, after everything. Yours, always: no program moves it. At -60 dB the plugin is silent."
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 45 ;
        lv2:symbol "gr" ;
        lv2:name "GR" ;
        lv2:default 0.0 ;
        lv2:minimum -24.0 ;
        lv2:maximum 0.0 ;
        units:unit units:db ;
        rdfs:comment "Output. Compressor gain reduction in dB, at its worst over the last block. 0 means the compressor is doing nothing."
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 46 ;
        lv2:symbol "level" ;
        lv2:name "LEVEL" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Output. Peak level leaving the plugin, 0 to 1, with a 300 ms fall so a peak stays visible."
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 47 ;
        lv2:symbol "gate_open" ;
        lv2:name "GATE OPEN" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Output. 1 while the gate is open."
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 48 ;
        lv2:symbol "fx_state" ;
        lv2:name "FX STATE" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Output. The FX state actually in force. It exists because the trigger and the toggle drive one state, and a plugin must not write back into either."
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 49 ;
        lv2:symbol "notches" ;
        lv2:name "NOTCHES" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 4.0 ;
        rdfs:comment "Output. How many anti-Larsen notches are in place right now. If this sits at its maximum the stage is fighting you, not the plugin."
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 50 ;
        lv2:symbol "time_out" ;
        lv2:name "TIME" ;
        lv2:default 400.0 ;
        lv2:minimum 20.0 ;
        lv2:maximum 2000.0 ;
        units:unit units:ms ;
        rdfs:comment "Output. The delay time in force, in milliseconds, whether it came from the knob or from the tap."
    ] .
